88 0 obj
<</Type/EmbeddedFile/Length 1727>>stream
"""JTK REF-480: exact integer reference and canonical LUT generator."""
from itertools import product
from pathlib import Path
import json, struct, hashlib

U = (-1, -1, -1, 0, 1, 1, 1)
C = (U, tuple(-v for v in U))

def step(s, w):
    x, p, tau, E, q = s
    r, d, b, f = w
    carrier = 1 if p < 2 else -1
    raw = carrier * x
    sensed = carrier * raw
    error = r - sensed
    observed_q = q ^ f
    sign = 1 if observed_q == 0 else -1
    decoded = sign * C[observed_q][error + 3]
    u = decoded if E > 0 else 0
    xn = min(2, max(-2, x + u + d))
    pn = (p + 1) % 4
    taun = (tau + int(E > 0)) % 4
    En = min(2, E + b - abs(u))
    qn = 0
    return ((xn, pn, taun, En, qn),
            (raw, sensed, error, u, observed_q))

def state_index(s):
    x, p, tau, E, q = s
    return ((((x+2)*4+p)*4+tau)*3+E)*2+q

def input_index(w):
    r, d, b, f = w
    return (((r+1)*3+(d+1))*2+b)*2+f

def address(s, w):
    return 36*state_index(s) + input_index(w)

STATES = tuple(product(range(-2,3), range(4), range(4), range(3), range(2)))
INPUTS = tuple(product(range(-1,2), range(-1,2), range(2), range(2)))

def build_tables():
    lut = tuple(step(s,w) for s in STATES for w in INPUTS)
    canonical = json.dumps(lut, separators=(",", ":")).encode("ascii")
    compact = b"".join(struct.pack("<H",state_index(n)) for n,o in lut)
    return canonical, compact

if __name__ == "__main__":
    canonical, compact = build_tables()
    Path("canonical_lut.json").write_bytes(canonical)
    Path("next_state_lut_u16le.bin").write_bytes(compact)
    print("canonical_lut.json", len(canonical), hashlib.sha256(canonical).hexdigest())
    print("next_state_lut_u16le.bin", len(compact), hashlib.sha256(compact).hexdigest())

endstream 
endobj
