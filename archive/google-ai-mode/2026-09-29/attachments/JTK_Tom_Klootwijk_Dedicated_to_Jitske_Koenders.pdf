JTK formal specification 1.0: equation source

(1) Page 2
\mathcal{T}_K:\mathcal{S}\times\mathcal{I}\longrightarrow\mathcal{S}\times\mathcal{O}

(2) Page 2
s_k=(x_k,z_k,c_k,d_k,p_k,\boldsymbol{\tau}_k,\boldsymbol{\mu}_k,E_k)

(3) Page 3
y_k=H_K(x_k,c_k,p_k,i_k),\qquad v_k=E_K(y_k,d_k,\boldsymbol{\tau}_k)

(4) Page 3
u_k=L_{c_k}[A_K(v_k,z_k)],\qquad x_{k+1}=P_K(x_k,u_k,i_k)

(5) Page 3
z_{k+1}=Z_K(z_k,y_k,u_k,i_k)

(6) Page 3
d_{k+1}=D_K(d_k,c_k,x_k,z_k,y_k,u_k,E_k,i_k)

(7) Page 3
c_{k+1}=B_K(d_{k+1})

(8) Page 3
J=\frac{I+S}{2},\quad J(a,b)=\left(\frac{a+b}{2},\frac{a+b}{2}\right),\quad J^2=J

(9) Page 3
v=Jv+(I-J)v,\qquad J(I-J)=0

(10) Page 4
g_\ell(a)=\operatorname{sgn}(a)\ln\left(1+\frac{|a|}{\ell}\right),\qquad g_\ell(0)=0

(11) Page 4
u=g_\ell(x),\quad v=g_\ell(y),\quad R_w=\sqrt{u^2+v^2}

(12) Page 4
\theta_w=\operatorname{OTAN2}(y,x)=\operatorname{atan2}(v,u)\,\mathrm{mod}\, 2\pi

(13) Page 4
\mathcal{W}(x,y,z)=\left(R_w,\theta_w,\zeta\right),\qquad \zeta=\frac{z-z_0}{H_z}

(14) Page 4
u=R_w\cos\theta_w,\qquad v=R_w\sin\theta_w

(15) Page 4
x=\ell\operatorname{sgn}(u)(e^{|u|}-1),\quad y=\ell\operatorname{sgn}(v)(e^{|v|}-1)

(16) Page 4
z=z_0+H_z\zeta

(17) Page 4
\rho=\sqrt{x^2+y^2},\quad r_{\log}=\ln(1+\rho/\ell),\quad \theta=\operatorname{atan2}(y,x)\,\mathrm{mod}\,2\pi

(18) Page 5
\Phi=\frac{1+\sqrt{5}}{2},\qquad F_1=F_2=1,\quad F_{n+2}=F_{n+1}+F_n

(19) Page 5
r_i=R\frac{F_{i+1}}{F_{N+1}},\qquad i=1,\ldots,N

(20) Page 5
\rho_j=R\Phi^{-j}\ (0\leq j\leq M),\quad \ln\rho_j-\ln\rho_{j+1}=\ln\Phi\ (j<M)

(21) Page 5
\rho(\theta)=a\exp\left(\frac{2\ln\Phi}{\pi}\theta\right),\quad \rho(\theta+\pi/2)=\Phi\rho(\theta)

(22) Page 5
H_R=\{(x,y,z):x^2+y^2+z^2\leq R^2,\ z\geq0\}

(23) Page 5
C_{R,H}=\{(x,y,z):0\leq z\leq H,\ H^2(x^2+y^2)\leq R^2(H-z)^2\}

(24) Page 5
\chi_{A\cap B}=\chi_A\chi_B,\quad\chi_{A\cup B}=\max(\chi_A,\chi_B),\quad\chi_{A\setminus B}=\chi_A(1-\chi_B)

(25) Page 6
\sigma_n(X)=\sum_{i,j}(W_{1,n})_{ij}X_{ij}(W_{2,n})_{ij}-\beta_n

(26) Page 6
\sigma_n(X)=\langle W_{1,n}\odot W_{2,n},X\rangle_F-\beta_n

(27) Page 6
|\sigma|\leq M=dABX_{\max}+B_0

(28) Page 6
w_{\mathrm{acc}}=1+\left\lceil\log_2(M+1)\right\rceil

(29) Page 6
\operatorname{work}=O(dh),\qquad h=O(\log N_{\mathrm{leaf}})\ \mathrm{for\ a\ balanced\ tree}

(30) Page 7
q_\theta=\left\lfloor\frac{4096\theta_w}{2\pi}\right\rfloor,\quad q_R=\min\left(4095,\left\lfloor\frac{4096R_w}{R_{w,\max}}\right\rfloor\right)

(31) Page 7
q_z=\min(255,\lfloor256\zeta\rfloor),\qquad A=2^{20}q_\theta+2^8q_R+q_z

(32) Page 7
2^{32}\ \mathrm{entries}\times8\ \mathrm{bytes}=2^{35}\ \mathrm{bytes}=32\ \mathrm{GiB}

(33) Page 7
A_T(s,i)=|\mathcal{I}|\,i_S(s)+i_I(i),\qquad L_T[A_T(s,i)]=\mathcal{T}_K(s,i)

(34) Page 8
b=\frac{R_2}{R_1+R_2}-\frac{R_4}{R_3+R_4},\qquad v_{\mathrm{out}}(t)=b\,v_{\mathrm{ex}}(t)

(35) Page 8
b=\frac{g\varepsilon}{4+2g\varepsilon},\qquad \varepsilon=\frac{4b}{g(1-2b)},\quad -\frac{1}{2}<b<\frac{1}{2}

(36) Page 8
R_1=R_4=R(1-g\varepsilon),\qquad R_2=R_3=R(1+g\varepsilon)

(37) Page 8
b=g\varepsilon,\qquad |g\varepsilon|<1

(38) Page 9
v_{\mathrm{ex}}(t)=V_c\cos(\omega_ct),\qquad V_c>0,\quad\omega_c>0

(39) Page 9
v_s(t)=G V_c b\cos(\omega_ct+\phi)+v_o+n(t),\qquad G>0

(40) Page 9
\widehat b=\frac{2}{GV_cT}\int_{t_0}^{t_0+T}v_s(t)\cos(\omega_ct)\,dt

(41) Page 9
\widehat b=b\cos\phi+\eta_c,\qquad\eta_c=\frac{2}{GV_cT}\int_{t_0}^{t_0+T}n(t)\cos(\omega_ct)\,dt

(42) Page 9
D=\sum_{j=0}^{N-1}a_jd_j,\qquad \bar b=\frac{D}{NA}

(43) Page 9
d_j=Aa_jb+o+n_j\quad\Longrightarrow\quad\bar b=b+\frac{1}{NA}\sum_{j=0}^{N-1}a_jn_j

(44) Page 9
\left|\widehat\varepsilon-\varepsilon\right|\leq\frac{4}{|g|(1-2b_{\max})^2}\,|\widehat b-b|,\qquad b_{\max}<\frac{1}{2}

(45) Page 10
m\ddot q+c\dot q+kq=f_{\mathrm{ext}}+k_a u,\qquad y=k_s q

(46) Page 10
e=r-y,\qquad \dot z=e,\qquad u=k_pe+k_iz

(47) Page 10
ms^3+cs^2+(k+k_ak_sk_p)s+k_ak_sk_i

(48) Page 10
k+k_ak_sk_p>0,\quad k_ak_sk_i>0,\quad c(k+k_ak_sk_p)>m k_ak_sk_i

(49) Page 10
q_\infty=0,\qquad u_\infty=-f_{\mathrm{ext}}/k_a

(50) Page 10
f_{\mathrm{ext}}=m\ddot q+c\dot q+kq-k_a u

(51) Page 10
\dot x=f_K(x,u,t),\qquad x(t_0)=x_0

(52) Page 11
t_k=t_0+k\Delta,\quad\Delta>0,\qquad p_{k+1}=(p_k+1)\,\mathrm{mod}\, N_c

(53) Page 11
\tau_{a,k+1}=(\tau_{a,k}+\mu_{a,k})\,\mathrm{mod}\, N_a,\qquad a\in\{B,E\}

(54) Page 11
\mu_{a,k+1}=M_{a,K}(x_k,c_k,E_k,i_k),\qquad 0\leq\mu_{a,k+1}<N_a

(55) Page 11
d_k=Q(h(x(t_k^-))),\qquad (s_{k+1},o_k)=\mathcal{T}_K(s_k,d_k)

(56) Page 11
u(t)=U(o_k),\qquad t_k\leq t<t_{k+1}

(57) Page 11
x_{k+1}=e^{A\Delta}x_k+\int_0^\Delta e^{A(\Delta-s)}B u_k\,ds

(58) Page 11
\dot E=P_{\mathrm{in}}-P_{\mathrm{sense}}-P_{\mathrm{act}}-P_{\mathrm{build}}-P_{\mathrm{diss}}

(59) Page 12
E_D(F_D(x,v))=\pi_{\mathcal{S}}\mathcal{T}_K(E_D(x),I_D(v))

(60) Page 12
\dot x=(J_H-R_H)\nabla\mathcal{H}+G_Hu,\qquad y=G_H^{\mathsf{T}}\nabla\mathcal{H}

(61) Page 12
J_H^{\mathsf{T}}=-J_H,\quad R_H=R_H^{\mathsf{T}}\succeq0,\quad\dot{\mathcal{H}}=-(\nabla\mathcal{H})^{\mathsf{T}}R_H\nabla\mathcal{H}+u^{\mathsf{T}}y

(62) Page 12
\dot{\xi}=N v(\xi)+j_{\mathrm{in}}-j_{\mathrm{out}},\qquad v_j(\xi)=k_j\prod_i\xi_i^{\nu_{ij}}

(63) Page 13
s=(x,p,\tau,E,q)\in\{-2,-1,0,1,2\}\times\mathbb{Z}_4\times\mathbb{Z}_4\times\{0,1,2\}\times\{0,1\}

(64) Page 13
w=(r,d,b,f)\in\{-1,0,1\}^2\times\{0,1\}^2

(65) Page 13
a(p)=(-1)^{\lfloor p/2\rfloor},\quad y_{\mathrm{raw}}=a(p)x,\quad\widehat x=a(p)y_{\mathrm{raw}}=x,\quad e=r-\widehat x

(66) Page 13
U=(-1,-1,-1,0,1,1,1),\qquad C_0=U,\quad C_1=-U

(67) Page 13
\widehat q=q\oplus f,\qquad u_0=(-1)^{\widehat q}C_{\widehat q}[e+3]=U[e+3]

(68) Page 13
x^+=\min(2,\max(-2,x+u+d)),\qquad p^+=(p+1)\,\mathrm{mod}\,4

(69) Page 13
\tau^+=(\tau+\mathbf{1}_{E>0})\,\mathrm{mod}\,4,\qquad E^+=\min(2,E+b-|u|)

(70) Page 13
q^+=0

(71) Page 14
L[A]=\operatorname{step}(s,w),\qquad A=36\,i_S(s)+i_I(w)

(72) Page 15
y_{\mathrm{raw}}=a(p)x,\qquad\widehat x=x,\qquad\widehat q=f\ \mathrm{along\ this\ trace}

(73) Page 16
a(p)^2=1,\qquad (-1)^{\widehat q}C_{\widehat q}[e+3]=U[e+3]

(74) Page 16
k_{\mathrm{hit}}\leq |r-x_0|+1\leq4

endstream 
