92 0 obj
<</Type/EmbeddedFile/Length 651>>stream
[identity]
author = Tom Klootwijk
identifier = NL200678942
date_of_birth = 10-07-1990
dedication = Jitske Koenders

[reference]
profile = JTK-REF-480-v1
state_order = x,p,tau,E,q
input_order = r,d,b,f
initial_state = -2,0,0,2,0
x_min = -2
x_max = 2
phase_modulus = 4
process_modulus = 4
resource_capacity = 2
canonical_representation = 0
controller_U = -1,-1,-1,0,1,1,1
bank_0 = U
bank_1 = -U

[execution]
arithmetic = integers
commit = simultaneous_after_ordered_evaluation
enumeration = ascending_lexicographic_product
address = 36*state_index+input_index
next_state_record = uint16_little_endian
next_state_records = 17280
next_state_bytes = 34560

endstream 
endobj
