  "html": "<body class=\"\">\n  \n  <div id=\"root\"><div class=\"w-full bg-card text-foreground select-none font-sans overflow-hidden\"><div class=\"relative w-full overflow-hidden border-b border-border bg-[#0a0f1d]\"><div class=\"absolute top-0 end-0 p-3 z-10 flex items-center justify-end pointer-events-none\"><button class=\"w-9 h-9 rounded-full flex items-center justify-center cursor-pointer transition-colors shadow-none bg-muted/90 hover:bg-secondary-hover text-foreground pointer-events-auto relative overflow-visible after:absolute after:-inset-1\" aria-label=\"Pause animation\"><span class=\"material-icons !text-base\">pause</span></button></div><svg role=\"img\" aria-label=\"Interactive 2D AR Spatial Simulation representing SLAM tracking coordinates, Carbohydrates, and Lipids collection grid.\" viewBox=\"0 0 640 360\" class=\"w-full h-auto block\"><defs><pattern id=\"slamGrid\" width=\"44\" height=\"44\" patternUnits=\"userSpaceOnUse\" x=\"12\" y=\"4\"><path d=\"M 44 0 L 0 0 0 44\" fill=\"none\" stroke=\"#1e293b\" stroke-width=\"1\" opacity=\"0.8\"></path></pattern></defs><rect width=\"640\" height=\"360\" fill=\"url(#slamGrid)\"></rect><circle cx=\"320\" cy=\"180\" r=\"110\" class=\"fill-none stroke-primary/15\" stroke-width=\"1.5\" stroke-dasharray=\"4 4\"></circle><circle cx=\"320\" cy=\"180\" r=\"50\" class=\"fill-none stroke-primary/10\" stroke-width=\"1\"></circle><g opacity=\"0.55\"><circle cx=\"320\" cy=\"180\" r=\"6\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"1\" stroke-dasharray=\"2 2\"></circle><circle cx=\"320\" cy=\"180\" r=\"2\" fill=\"#ffffff\"></circle><text x=\"328\" y=\"184\" fill=\"#ffffff\" font-size=\"11\" font-weight=\"normal\" opacity=\"0.7\">0.0 (SLAM Origin)</text></g><g transform=\"translate(320, 180)\"><circle cx=\"0\" cy=\"0\" r=\"24\" fill=\"rgba(51, 110, 243, 0.08)\" stroke=\"#336ef3\" stroke-width=\"1\" stroke-dasharray=\"3 2\"></circle><g transform=\"rotate(0)\"><line x1=\"0\" y1=\"0\" x2=\"32\" y2=\"0\" stroke=\"#336ef3